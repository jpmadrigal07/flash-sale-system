PORT=3000
# Preferred: Upstash REST credentials (maps to Redis TLS, so Lua still runs atomically).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Or set REDIS_URL directly. If set, it wins over the Upstash pair.
# REDIS_URL=redis://localhost:6379
SALE_START_TIME=2026-01-01T00:00:00.000Z
SALE_END_TIME=2026-12-31T23:59:59.000Z
TOTAL_STOCK=100
CORS_ORIGIN=http://localhost:5173
RESEED_ON_BOOT=true
