PORT=3000
# Default: local Redis.
REDIS_URL=redis://localhost:6379
# Upstash: comment REDIS_URL out, then set both. Use the REST URL (https://…)
# and REST token from the console — not the rediss:// URL in these two fields.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
SALE_START_TIME=2026-01-01T00:00:00.000Z
SALE_END_TIME=2026-12-31T23:59:59.000Z
TOTAL_STOCK=100
CORS_ORIGIN=http://localhost:5173
RESEED_ON_BOOT=true
